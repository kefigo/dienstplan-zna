{
  "name": "dienstplan-zna",
  "version": "1.0.0",
  "description": "Wochendienstplan für die Notaufnahme mit eigener Anmeldung und Rechteverwaltung",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "@fontsource/ibm-plex-sans-condensed": "5.1.1",
    "express": "4.21.2",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2"
  }
}
